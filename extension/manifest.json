{
  "manifest_version": 3,
  "name": "Anime Mine",
  "version": "0.3.4",
  "description": "Clickable Japanese subtitles with dictionary lookup and Anki mining via the Anime Mine app.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "*://*.crunchyroll.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["lib/captions.js", "lib/subs.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anime-mine@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}

  "glossary": {
    "g:genki-kosoado": {
      "label": "これ・それ・あれ / この・その・あの",
      "meaning": "this / that / that over there",
      "note": "これ, それ, あれ stand alone (\"this one\"); この, その, あの go before a noun (この ケーキ). ここ, そこ, あそこ are places."
    },
    "k:円": {
      "label": "円",
      "reading": "えん",
      "meaning": "yen, circle"
    },
    "g:n5-mo": {
      "label": "〜も",
      "meaning": "also / too",
      "note": "も replaces は, が, or を when the item is also true or included. Do not add は after も; も already marks the topic. It can attach to nouns, verbs, and adjectives."
    },
    "g:genki-ja-nai": {
      "label": "〜じゃないです",
      "meaning": "is not (polite negative of です)",
      "note": "Noun + じゃないです (or じゃありません): わたしの かさじゃないです = it is not my umbrella."
    }
  },
  "beats": [

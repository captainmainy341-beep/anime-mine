  "glossary": {
    "g:n5-wa-desu": {
      "label": "〜は〜です",
      "meaning": "X is Y (polite copula)",
      "note": "Connects a topic (は, read wa) to a noun or description. The polite negative is じゃありません; the plain form is だ."
    },
    "g:n5-no": {
      "label": "〜の",
      "meaning": "of / 's (possession or modification)",
      "note": "の links two nouns: the first owns or describes the second. At the end of a casual sentence, の can soften a statement or express a feeling."
    },
    "g:n5-ka": {
      "label": "〜か",
      "meaning": "question marker (yes/no question)",
      "note": "Adding か at the end of a sentence turns it into a question. In speech it can be shown with a rising tone. In casual talk か is often dropped and only the rising tone remains."
    },
    "k:先": {
      "label": "先",
      "reading": "せん / さき",
      "meaning": "ahead, previous"
    }
  },

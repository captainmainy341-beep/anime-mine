  "glossary": {
    "g:n4-potential": {
      "label": "〜られる / 〜える",
      "meaning": "can do / be able to",
      "note": "Ru-verbs add られる (食べる → 食べられる). U-verbs change the last sound to the え-row and add る (飲む → 飲める). する becomes できる, 来る becomes 来られる. The thing you can do usually takes が."
    },
    "g:genki-shi": {
      "label": "〜し、〜し",
      "meaning": "... and besides, ...",
      "note": "し joins reasons after plain-form clauses: 安いし、おいしいし、好きです. It hints that there are more reasons than the ones you list."
    },
    "g:n4-sou-da-appearance": {
      "label": "〜そうです",
      "meaning": "looks like / seems about to",
      "note": "Attach to the stem of a verb or an adjective to say how something looks: おいしそう, 降りそう. いい becomes よさそう, ない becomes なさそう."
    },
    "g:n5-ga-subject": {
      "label": "〜が",
      "meaning": "subject marker; object of can-do verbs",
      "note": "が marks the subject and, with verbs of ability or feeling, the thing that can be done: 日本語が話せる."
    },
    "k:店": {
      "label": "店",
      "meaning": "shop, store",
      "reading": "みせ"
    },
    "k:作": {
      "label": "作",
      "meaning": "make",
      "reading": "つく(る)"
    }
  },
